{
  "name": "dsh-notice-hooks",
  "version": "0.1.3",
  "description": "Configure automation Hooks for user and project scopes to run commands on session, tool, permission, and context-compaction events. Manage Hook authorization manually in Hooks setting.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hooks",
    "workflow"
  ],
  "homepage": "https://github.com/oliverCJ/dsh-notice-hooks#readme",
  "bugs": {
    "url": "https://github.com/oliverCJ/dsh-notice-hooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverCJ/dsh-notice-hooks.git"
  },
  "author": "oliverCJ",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "assets",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "test": "vitest run",
    "check:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown",
    "check": "pnpm run typecheck && pnpm run typecheck:test && pnpm run test && pnpm run build",
    "prepack": "pnpm run build",
    "release:check": "pnpm run check && npm publish --dry-run --access public --registry=https://registry.npmjs.org/",
    "release:publish": "pnpm run release:check && npm publish --access public --registry=https://registry.npmjs.org/"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <0.2.2 || >=0.2.2-0 <0.3.0",
    "react": "^18.3.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-native-command": "0.2.2-rc.1",
    "string-argv": "^0.3.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "27.2.0",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
